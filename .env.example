# Circular Replay API (GET /v1/replay)
CIRCULAR_REPLAY_URL=http://localhost:8080
CIRCULAR_REPLAY_API_KEY=

# Used by `compare_rpc` only (getTransaction for tx bytes + meta)
RPC_URL=https://api.mainnet-beta.solana.com

# Optional: directory of mainnet `.so` overrides (default: crate `programs/`)
# REPLAY_PROGRAMS_DIR=programs
